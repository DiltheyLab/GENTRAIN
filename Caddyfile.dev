# Backend API (FLASK) 
api.localhost {
	tls internal
	header Access-Control-Allow-Methods "*"
	header Access-Control-Allow-Origin "*"
	header Access-Control-Allow-Headers "*"

	@options {
		method OPTIONS
	}
	respond @options 200

	# Reverse proxy to the api docker container
	reverse_proxy api:8080
	log {
		output stdout
	}
}

# Frontend app (React)
localhost {
	tls internal
	root * /srv
	try_files {path} /index.html
	file_server
	log {
		output stdout
	}
}
