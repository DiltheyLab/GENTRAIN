{
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc -w",
    "lint": "eslint \"src\"",
    "start": "node dist/app.js",
    "dev": "concurrently \"tsc --watch\" \"nodemon\"",
    "dev:prisma-pull": "npm run with-env -- npx prisma db pull",
    "dev:prisma-init-migrate": "npm run with-env -- npx prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > prisma/migrations/0_init/migration.sql",
    "dev:prisma-resolve": "npm run with-env -- npx prisma migrate resolve --applied 0_init",
    "dev:prisma-migrate": "npm run with-env -- npx prisma migrate dev --name",
    "dev:prisma-push": "npm run with-env -- npx prisma db push",
    "dev:prisma-studio": "npm run with-env -- npx prisma studio",
    "dev:prisma-seed": "npm run with-env -- npx prisma db seed",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@adminjs/express": "^6.1.1",
    "@adminjs/logger": "^5.0.1",
    "@adminjs/prisma": "^5.0.4",
    "@adminjs/upload": "^4.0.2",
    "@prisma/client": "^5.6.0",
    "@types/adm-zip": "^0.5.7",
    "@types/unzipper": "^0.10.11",
    "adm-zip": "^0.5.16",
    "adminjs": "^7.8.17",
    "argon2": "^0.44.0",
    "clamscan": "^2.4.0",
    "connect-pg-simple": "^10.0.0",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "express-formidable": "^1.2.0",
    "express-session": "^1.17.3",
    "fast-csv": "^5.0.5",
    "fs-extra": "^11.3.1",
    "get-folder-size": "^5.0.0",
    "pg": "latest",
    "unzipper": "^0.12.3",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.23",
    "@types/express-session": "^1.18.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^18.15.11",
    "@typescript-eslint/eslint-plugin": "^5.58.0",
    "@typescript-eslint/parser": "^5.58.0",
    "concurrently": "^9.2.0",
    "dotenv-cli": "^7.2.1",
    "eslint": "^8.38.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.1.0",
    "prisma": "^5.6.0",
    "tslib": "^2.5.0",
    "typescript": "^5.0.4"
  },
  "name": "admin",
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "node prisma/seed.js"
  }
}
