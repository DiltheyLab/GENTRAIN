generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model pathogen {
  id                                 Int     @id @default(autoincrement())
  name                               String  @db.VarChar
  genetic_distance_threshold         Int
  type                               String  @db.VarChar
  scheme_name                        String  @db.VarChar
  scheme_file_name                   String? @db.VarChar
  scheme_key                         String? @db.VarChar
  scheme_file_path                   String? @db.VarChar
  scheme_size                        Int?
  scheme_bucket                      String?
  scheme_files_to_delete             String?
  scheme_mime_type                   String?
  cases_example_data_key             String? @db.VarChar
  cases_example_data_file_path       String? @db.VarChar
  cases_example_data_size            Int?
  cases_example_data_bucket          String?
  cases_exmaple_data_file_name       String?
  cases_example_data_files_to_delete String?
  cases_exmaple_data_mime_type       String?
}

model role {
  id          Int     @id @default(autoincrement())
  name        String? @unique @db.VarChar(80)
  description String? @db.VarChar(255)
}

model session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}

model user {
  id            Int       @id @default(autoincrement())
  password      String?   @db.VarChar(255)
  active        Boolean?
  confirmed_at  DateTime? @db.Timestamp(6)
  fs_uniquifier String    @unique @db.VarChar(64)
  username      String?   @unique @db.VarChar
  last_login_at DateTime? @db.Timestamp(6)
}
