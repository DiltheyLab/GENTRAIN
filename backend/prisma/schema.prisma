generator js_client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x", "windows"]
  output        = "clients"
}

generator py_client {
  provider  = "prisma-client-py"
  interface = "sync"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model pathogen {
  id                         Int       @id @default(autoincrement())
  name                       String    @db.VarChar
  genetic_distance_threshold Int
  type                       String    @db.VarChar
  activated                  Boolean   @default(false) @db.Boolean
  scheme_version             DateTime? @db.Timestamp(6)
  scheme_size                Int?
  example_cases_key          String?   @db.VarChar
  example_cases_size         Int?
  example_cases_bucket       String?
  example_sequences_key      String?   @db.VarChar
  example_sequences_size     Int?
  example_sequences_bucket   String?
  example_contacts_key       String?   @db.VarChar
  example_contacts_size      Int?
  example_contacts_bucket    String?
}

model role {
  id          Int     @id @default(autoincrement())
  name        String? @unique @db.VarChar(80)
  description String? @db.VarChar(255)
  users       user[]
}

model session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}

model user {
  id           Int       @id @default(autoincrement())
  password     String?   @db.VarChar(255)
  confirmed_at DateTime? @db.Timestamp(6)
  username     String    @unique @db.VarChar
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @db.Timestamp(6)
  role         role      @relation(fields: [roleId], references: [id])
  roleId       Int
}

model log {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  recordId    Int
  recordTitle String?  @db.VarChar(128)
  difference  Json?    @db.Json
  action      String   @db.VarChar(128)
  resource    String   @db.VarChar(128)
  userId      String   @db.VarChar(128)
}
