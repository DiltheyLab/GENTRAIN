# --- Stage 1: Build ---
FROM node:22-alpine AS builder
WORKDIR /app

# Build-Argument
ARG VITE_API_HOST
ENV VITE_API_HOST=$VITE_API_HOST

COPY package*.json ./
RUN npm ci
RUN npm i -g vite
COPY . .
RUN npm run build

# --- Stage 2: Runtime (keep only output) ---
FROM alpine
WORKDIR /app
COPY --from=builder /app/dist ./dist